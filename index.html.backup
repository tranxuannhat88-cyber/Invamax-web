    <!-- INVAMAX HOMEPAGE VISUAL SYSTEM -->
    <style>
        :root {
            --home-bg-main: var(--bg-color, #0f172a); 
            --home-bg-alt: var(--bg-dark, #0b1120);
            --home-card-bg: rgba(255, 255, 255, 0.02);
            --home-card-border: rgba(255, 255, 255, 0.08);
            --home-card-border-hover: rgba(234, 88, 12, 0.4);
            --home-text-primary: #ffffff;
            --home-text-muted: #94a3b8;
            --home-orange: #ea580c;
            --home-radius-large: 16px;
            --home-radius-card: 12px;
        }
        
        .home-section {
            padding: 80px 0;
            background-color: var(--home-bg-main);
            border-radius: 0 !important;
        }
        .home-section-alt {
            padding: 80px 0;
            background-color: var(--home-bg-alt);
            border-radius: 0 !important;
        }
        
        .home-header {
            text-align: center;
            margin-bottom: 50px;
        }
        .home-h2 {
            font-size: 2.2rem;
            font-weight: 800;
            color: var(--home-text-primary);
            margin-bottom: 16px;
        }
        .home-subtitle {
            font-size: 1.1rem;
            color: var(--home-text-muted);
            line-height: 1.6;
            max-width: 800px;
            margin: 0 auto;
        }
        .home-eyebrow {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--home-orange);
            font-weight: 700;
            margin-bottom: 12px;
            display: inline-block;
        }
        
        .home-card {
            background: var(--home-card-bg);
            border: 1px solid var(--home-card-border);
            border-radius: var(--home-radius-card);
            padding: 32px 24px;
            transition: all 0.3s ease;
            box-shadow: none !important;
            display: flex;
            flex-direction: column;
            text-align: left;
        }
        .home-card:hover {
            border-color: var(--home-card-border-hover);
            transform: translateY(-2px);
            background: rgba(255, 255, 255, 0.03);
        }
        .home-card-icon-wrapper {
            width: 48px;
            height: 48px;
            border-radius: 8px;
            background: rgba(234, 88, 12, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
            border: 1px solid rgba(234, 88, 12, 0.2);
            flex-shrink: 0;
        }
        .home-card-icon {
            color: var(--home-orange);
            width: 24px;
            height: 24px;
        }
        
        .home-quote-block {
            background: var(--home-bg-alt);
            border-left: 4px solid var(--home-orange);
            padding: 24px 32px;
            border-radius: 0 var(--home-radius-card) var(--home-radius-card) 0;
            margin: 40px auto 0;
            max-width: 800px;
            text-align: left;
        }
        .home-quote-block p {
            color: var(--home-text-primary);
            font-size: 1.15rem;
            line-height: 1.6;
            font-weight: 500;
            margin: 0;
            font-style: normal;
        }

        .home-pill {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 100px;
            padding: 6px 16px;
            color: var(--home-text-muted);
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
        }
        .home-pill:hover {
            border-color: var(--home-orange);
            color: white;
            background: rgba(234, 88, 12, 0.1);
        }
        
        .home-btn-primary {
            background: var(--home-orange);
            color: white;
            border: none;
            padding: 12px 28px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1rem;
            display: inline-block;
            text-decoration: none;
            transition: background 0.2s;
        }
        .home-btn-primary:hover {
            background: #c2410c;
        }
        .home-btn-secondary {
            background: transparent;
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 12px 28px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1rem;
            display: inline-block;
            text-decoration: none;
            transition: all 0.2s;
        }
        .home-btn-secondary:hover {
            border-color: white;
            background: rgba(255, 255, 255, 0.05);
        }
        
        @media (max-width: 768px) {
            .home-section, .home-section-alt { padding: 56px 0; }
            .home-h2 { font-size: 1.75rem; }
            .home-quote-block { padding: 20px; }
        }
    </style>
</head>
